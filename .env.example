# Copy to .env and adjust. Never commit .env.
# All variables use the ONBOARDIQ_ prefix (see app/core/config.py).

ONBOARDIQ_ENVIRONMENT=dev
ONBOARDIQ_LOG_LEVEL=INFO

# Replace in any non-local environment.
ONBOARDIQ_API_KEY=change-me

ONBOARDIQ_DATABASE_URL=postgresql+asyncpg://onboardiq:onboardiq@localhost:5432/onboardiq

ONBOARDIQ_MAX_UPLOAD_MB=10
ONBOARDIQ_MAX_UPLOAD_ROWS=50000
